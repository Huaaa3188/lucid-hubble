---
// Layout.astro - 极简杂志风全局母版
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getSiteUrl } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  publishedTime?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = "服务端工程、开发工具、读书与日常随笔。",
  keywords = "服务端工程, 开发工具, 读书笔记, 日常随笔, Astro博客",
  canonicalUrl: canonicalUrlProp,
  ogType = "website",
  ogImage: ogImageProp,
  publishedTime,
  structuredData
} = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = `${basePath}/`;
const writingUrl = `${basePath}/#blog`;
const aboutUrl = `${basePath}/about/`;
const pagePath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalPath = pagePath.startsWith(homeUrl) ? pagePath : `${basePath}${pagePath}`;
const canonicalUrl = canonicalUrlProp ?? new URL(canonicalPath, Astro.site ?? Astro.url).toString();
const ogImage = ogImageProp ?? getSiteUrl('og-default.png');
const isAboutPage = canonicalPath.startsWith(aboutUrl);
const isWritingPage = !isAboutPage;
const githubUrl = "https://github.com/huaaa3188";
const rssUrl = getSiteUrl('rss.xml');
const jsonLd = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : undefined;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  
  <!-- 电影级跨页平滑转场机制 -->
  <ClientRouter />
  
  <!-- SEO Meta Tags -->
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>
  <meta name="author" content="Lucid">
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:site_name" content="Lucid Hubble">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:type" content={ogType}>
  <meta property="og:image" content={ogImage}>
  {publishedTime && <meta property="article:published_time" content={publishedTime}>}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={ogImage}>
  <link rel="alternate" type="application/rss+xml" title="Lucid Hubble" href={rssUrl}>
  {jsonLd && <script type="application/ld+json" set:html={jsonLd}></script>}
  
  <!-- Favicon (Fallback Emoji SVG) -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><style>text{fill:%231c1c1c}@media(prefers-color-scheme:dark){text{fill:%23e5e5e5}}</style><text x=%2250%%22 y=%2255%%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22 font-size=%2290%22 font-family=%22Georgia, serif%22 font-weight=%22bold%22>L</text></svg>">
  
  <!-- 立即检测暗黑模式并设置，防止页面出现闪烁 (FOUC) -->
  <script is:inline>
    const sunSvgInline = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>';
    const moonSvgInline = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>';

    const syncThemeIcon = () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const btn = document.getElementById('theme-toggle');
      if (btn) {
        btn.innerHTML = isDark ? sunSvgInline : moonSvgInline;
        btn.setAttribute('aria-label', isDark ? '切换至亮色模式' : '切换至暗色模式');
      }
    };

    const applyTheme = () => {
      const savedTheme = localStorage.getItem('theme');
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      
      if (savedTheme === 'dark' || (!savedTheme && systemPrefersDark)) {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.setAttribute('data-theme', 'light');
      }
      syncThemeIcon();
    };
    
    // 首屏物理载入时立即应用，防闪烁
    applyTheme();
    document.addEventListener('DOMContentLoaded', syncThemeIcon);
    document.addEventListener('astro:after-swap', applyTheme);
  </script>
</head>
<body>
  <div id="read-progress" class="read-progress"></div>
  <div class="container">
    <!-- Header -->
    <header class="site-header">
      <a href={homeUrl} class="logo">Lucid Hubble.</a>
      <nav class="nav-links">
        <a href={writingUrl} class={isWritingPage ? 'is-active' : undefined} aria-current={isWritingPage ? 'location' : undefined}>Writing</a>
        <a href={aboutUrl} class={isAboutPage ? 'is-active' : undefined} aria-current={isAboutPage ? 'page' : undefined} data-astro-prefetch>About</a>
        <!-- Dark Mode Toggle Button -->
        <button id="theme-toggle" class="theme-toggle" aria-label="切换暗黑模式">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        </button>
      </nav>
    </header>

    <!-- Main Dynamic Content Slot -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div>
        &copy; 2026 Lucid Hubble. 记录工程、工具与日常思考。
      </div>
      <div class="footer-socials">
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-icon"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </a>
      </div>
    </footer>
  </div>

  <!-- 客户端主题切换绑定与图标初始化逻辑 -->
  <script>
    const sunSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>';
    const moonSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>';

    // 更新按钮状态图标
    function updateToggleIcon() {
      const themeToggleBtn = document.getElementById('theme-toggle');
      if (!themeToggleBtn) return;

      const currentTheme = document.documentElement.getAttribute('data-theme');
      
      if (currentTheme === 'dark') {
        themeToggleBtn.innerHTML = sunSvg;
        themeToggleBtn.setAttribute('aria-label', '切换至亮色模式');
      } else {
        themeToggleBtn.innerHTML = moonSvg;
        themeToggleBtn.setAttribute('aria-label', '切换至暗色模式');
      }
    }

    // 绑定事件与初始化
    function initThemeToggle() {
      const themeToggleBtn = document.getElementById('theme-toggle');
      if (themeToggleBtn) {
        themeToggleBtn.removeEventListener('click', handleToggle);
        themeToggleBtn.addEventListener('click', handleToggle);
      }
      updateToggleIcon();
    }

    function handleToggle() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      
      updateToggleIcon();
    }

    function updateProgress() {
      const progressBar = document.getElementById('read-progress');
      if (!progressBar) return;

      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = `${scrollPercent}%`;
    }

    // 阅读进度条更新逻辑（仅在文章详情页起效）
    function initProgressBar() {
      const progressBar = document.getElementById('read-progress');
      if (!progressBar) return;

      window.removeEventListener('scroll', updateProgress);

      const isArticlePage = document.querySelector('article.post-detail-article');
      if (!isArticlePage) {
        progressBar.style.width = '0%';
        return;
      }

      window.addEventListener('scroll', updateProgress);
      updateProgress();
    }

    // 适配 Astro View Transitions 的标准生命周期
    document.addEventListener('astro:page-load', () => {
      initThemeToggle();
      initProgressBar();
    });
  </script>
</body>
</html>
