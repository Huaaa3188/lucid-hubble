---
// Layout.astro - 极客工程与终端控制台全局母版
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getSitePath, getSiteUrl, serializeJson, siteBasePath, siteConfig } from '../lib/site';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  structuredData?: Record<string, unknown>;
  wide?: boolean;
}

const {
  title,
  description = siteConfig.description,
  keywords = '服务端工程, 开发工具, 读书笔记, 日常随笔, Astro博客',
  canonicalUrl: canonicalUrlProp,
  ogType = 'website',
  ogImage: ogImageProp,
  publishedTime,
  structuredData,
  wide = false,
} = Astro.props;

const homeUrl = getSitePath();
const writingUrl = getSitePath('#blog');
const aboutUrl = getSitePath('about/');
const pagePath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalPath = pagePath.startsWith(siteBasePath) ? pagePath : `${siteBasePath}${pagePath}`;
const canonicalUrl = canonicalUrlProp ?? new URL(canonicalPath, Astro.site ?? Astro.url).toString();
const ogImage = ogImageProp ?? getSiteUrl('og-default.png');
const isAboutPage = canonicalPath.startsWith(aboutUrl);
const isWritingPage = !isAboutPage;
const githubUrl = siteConfig.githubUrl;
const rssUrl = getSiteUrl('rss.xml');
const jsonLd = structuredData ? serializeJson(structuredData) : undefined;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>

  <ClientRouter />

  <!-- SEO Meta Tags -->
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>
  <meta name="author" content={siteConfig.author}>
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:site_name" content={siteConfig.name}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:type" content={ogType}>
  <meta property="og:image" content={ogImage}>
  {publishedTime && <meta property="article:published_time" content={publishedTime}>}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={ogImage}>
  <link rel="alternate" type="application/rss+xml" title={siteConfig.name} href={rssUrl}>
  {jsonLd && <script type="application/ld+json" set:html={jsonLd}></script>}

  <!-- Terminal Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%230d1117'/><text x='16' y='68' font-family='monospace' font-weight='bold' font-size='56' fill='%2358a6ff'>&gt;_</text></svg>">

  <!-- Theme before paint -->
  <script is:inline>
    const applyTheme = () => {
      const savedTheme = localStorage.getItem('theme');
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      let theme = 'dark';
      if (savedTheme === 'light' || (!savedTheme && !systemPrefersDark)) {
        theme = 'light';
      }

      document.documentElement.setAttribute('data-theme', theme);

      const btn = document.getElementById('theme-toggle');
      if (btn) {
        btn.setAttribute('aria-label', theme === 'dark' ? '切换至亮色模式' : '切换至暗色模式');
      }
    };

    applyTheme();
    document.addEventListener('astro:after-swap', applyTheme);
  </script>
</head>
<body>
  <div id="read-progress" class="read-progress"></div>
  <div class:list={['container', { 'container-wide': wide }]}>
    <header class="site-header" transition:name="site-header">
      <div class="logo-wrap">
        <a href={homeUrl} class="logo" transition:name="site-logo">
          <span class="logo-prompt">&gt;_</span>
          <span>LUCID_HUBBLE</span>
          <span class="cursor-blink" aria-hidden="true"></span>
        </a>
      </div>

      <nav class="nav-links">
        <div class="status-indicator">
          <span class="pulse-dot"></span>
          <span>ONLINE</span>
        </div>
        <a href={writingUrl} class={isWritingPage ? 'is-active' : undefined} aria-current={isWritingPage ? 'location' : undefined}>~/writings</a>
        <a href={aboutUrl} class={isAboutPage ? 'is-active' : undefined} aria-current={isAboutPage ? 'page' : undefined} data-astro-prefetch>~/about</a>
        <button id="theme-toggle" type="button" class="theme-toggle" aria-label="切换主题">
          <span class="theme-icon theme-icon-moon">
            <Icon name="moon" size={16} />
          </span>
          <span class="theme-icon theme-icon-sun">
            <Icon name="sun" size={16} />
          </span>
        </button>
      </nav>
    </header>

    <main class="site-main" transition:animate="fade">
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <span>[SYS_READY]</span> &copy; 2026 {siteConfig.name}. All systems nominal.
      </div>
      <div class="footer-socials">
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <Icon name="github" class="footer-icon" />
        </a>
        <a href={rssUrl} target="_blank" rel="noopener noreferrer" aria-label="RSS Feed">
          <Icon name="feather" class="footer-icon" />
        </a>
      </div>
    </footer>
  </div>

  <script src="../scripts/site.ts"></script>
</body>
</html>
