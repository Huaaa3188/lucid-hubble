---
// Layout.astro - 极客工程与终端控制台全局母版
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getSiteUrl } from '../lib/site';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  publishedTime?: string;
  structuredData?: Record<string, unknown>;
  wide?: boolean;
}

const {
  title,
  description = "服务端工程、开发工具、读书与日常随笔。",
  keywords = "服务端工程, 开发工具, 读书笔记, 日常随笔, Astro博客",
  canonicalUrl: canonicalUrlProp,
  ogType = "website",
  ogImage: ogImageProp,
  publishedTime,
  structuredData,
  wide = false
} = Astro.props;

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = `${basePath}/`;
const writingUrl = `${basePath}/#blog`;
const aboutUrl = `${basePath}/about/`;
const pagePath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalPath = pagePath.startsWith(homeUrl) ? pagePath : `${basePath}${pagePath}`;
const canonicalUrl = canonicalUrlProp ?? new URL(canonicalPath, Astro.site ?? Astro.url).toString();
const ogImage = ogImageProp ?? getSiteUrl('og-default.png');
const isAboutPage = canonicalPath.startsWith(aboutUrl);
const isWritingPage = !isAboutPage;
const githubUrl = "https://github.com/huaaa3188";
const rssUrl = getSiteUrl('rss.xml');
const jsonLd = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : undefined;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  
  <ClientRouter />
  
  <!-- SEO Meta Tags -->
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>
  <meta name="author" content="Lucid">
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:site_name" content="Lucid Hubble">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:type" content={ogType}>
  <meta property="og:image" content={ogImage}>
  {publishedTime && <meta property="article:published_time" content={publishedTime}>}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={ogImage}>
  <link rel="alternate" type="application/rss+xml" title="Lucid Hubble" href={rssUrl}>
  {jsonLd && <script type="application/ld+json" set:html={jsonLd}></script>}
  
  <!-- Terminal Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%230d1117'/><text x='16' y='68' font-family='monospace' font-weight='bold' font-size='56' fill='%2358a6ff'>&gt;_</text></svg>">
  
  <!-- Theme before paint -->
  <script is:inline>
    const applyTheme = () => {
      const savedTheme = localStorage.getItem('theme');
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = savedTheme === 'light' ? 'light' : (!savedTheme && !systemPrefersDark ? 'light' : 'dark');

      document.documentElement.setAttribute('data-theme', theme);

      const btn = document.getElementById('theme-toggle');
      if (btn) {
        btn.setAttribute('aria-label', theme === 'dark' ? '切换至亮色模式' : '切换至暗色模式');
      }
    };

    applyTheme();
    document.addEventListener('astro:after-swap', applyTheme);
  </script>
</head>
<body>
  <div id="read-progress" class="read-progress"></div>
  <div class:list={['container', { 'container-wide': wide }]}>
    <header class="site-header" transition:name="site-header">
      <div class="logo-wrap">
        <a href={homeUrl} class="logo" transition:name="site-logo">
          <span class="logo-prompt">&gt;_</span>
          <span>LUCID_HUBBLE</span>
          <span class="cursor-blink" aria-hidden="true"></span>
        </a>
      </div>

      <nav class="nav-links">
        <div class="status-indicator">
          <span class="pulse-dot"></span>
          <span>ONLINE</span>
        </div>
        <a href={writingUrl} class={isWritingPage ? 'is-active' : undefined} aria-current={isWritingPage ? 'location' : undefined}>~/writings</a>
        <a href={aboutUrl} class={isAboutPage ? 'is-active' : undefined} aria-current={isAboutPage ? 'page' : undefined} data-astro-prefetch>~/about</a>
        <button id="theme-toggle" type="button" class="theme-toggle" aria-label="切换主题">
          <span class="theme-icon theme-icon-moon">
            <Icon name="moon" size={16} />
          </span>
          <span class="theme-icon theme-icon-sun">
            <Icon name="sun" size={16} />
          </span>
        </button>
      </nav>
    </header>

    <main class="site-main" transition:animate="fade">
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <span>[SYS_READY]</span> &copy; 2026 Lucid Hubble. All systems nominal.
      </div>
      <div class="footer-socials">
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <Icon name="github" class="footer-icon" />
        </a>
        <a href={rssUrl} target="_blank" rel="noopener noreferrer" aria-label="RSS Feed">
          <Icon name="feather" class="footer-icon" />
        </a>
      </div>
    </footer>
  </div>

  <script>
    function syncThemeAria() {
      const themeToggleBtn = document.getElementById('theme-toggle');
      if (!themeToggleBtn) return;
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      themeToggleBtn.setAttribute('aria-label', isDark ? '切换至亮色模式' : '切换至暗色模式');
    }

    function handleToggle() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      syncThemeAria();
    }

    function initThemeToggle() {
      const themeToggleBtn = document.getElementById('theme-toggle');
      if (!themeToggleBtn) return;
      themeToggleBtn.removeEventListener('click', handleToggle);
      themeToggleBtn.addEventListener('click', handleToggle);
      syncThemeAria();
    }

    function updateProgress() {
      const progressBar = document.getElementById('read-progress');
      if (!progressBar) return;

      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = `${scrollPercent}%`;
    }

    function initProgressBar() {
      const progressBar = document.getElementById('read-progress');
      if (!progressBar) return;

      window.removeEventListener('scroll', updateProgress);

      const isArticlePage = document.querySelector('article.post-detail-article');
      if (!isArticlePage) {
        progressBar.style.width = '0%';
        return;
      }

      window.addEventListener('scroll', updateProgress);
      updateProgress();
    }

    function initCodeBlocks() {
      const pres = document.querySelectorAll<HTMLPreElement>('.post-content pre');
      pres.forEach((pre) => {
        if (pre.parentElement?.classList.contains('code-wrapper')) return;

        const wrapper = document.createElement('div');
        wrapper.className = 'code-wrapper';

        const header = document.createElement('div');
        header.className = 'code-header';

        const dots = document.createElement('div');
        dots.className = 'console-dots';
        dots.innerHTML = '<span class="console-dot dot-red"></span><span class="console-dot dot-yellow"></span><span class="console-dot dot-green"></span>';

        const lang = pre.getAttribute('data-language') || 'code';
        const langEl = document.createElement('span');
        langEl.className = 'code-lang';
        langEl.textContent = `[${lang.toUpperCase()}]`;

        const copyBtn = document.createElement('button');
        copyBtn.className = 'copy-btn';
        copyBtn.type = 'button';
        copyBtn.textContent = 'COPY';
        copyBtn.setAttribute('aria-label', '复制代码');

        copyBtn.addEventListener('click', async () => {
          const codeText = pre.querySelector('code')?.innerText || pre.innerText;
          try {
            await navigator.clipboard.writeText(codeText);
            copyBtn.textContent = 'COPIED ✓';
            copyBtn.classList.add('copied');
            setTimeout(() => {
              copyBtn.textContent = 'COPY';
              copyBtn.classList.remove('copied');
            }, 2000);
          } catch (err) {
            console.error('Failed to copy code: ', err);
          }
        });

        header.appendChild(dots);
        header.appendChild(langEl);
        header.appendChild(copyBtn);

        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(header);
        wrapper.appendChild(pre);
      });
    }

    function initTocScrollSpy() {
      const headings = document.querySelectorAll<HTMLElement>('.post-content h2, .post-content h3');
      const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
      if (!headings.length || !tocLinks.length) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.getAttribute('id');
              tocLinks.forEach((link) => {
                const href = link.getAttribute('href') || '';
                const isActive = href === `#${id}`;
                link.classList.toggle('is-active', isActive);
              });
            }
          });
        },
        { rootMargin: '-20% 0px -70% 0px' }
      );

      headings.forEach((h) => observer.observe(h));
    }

    document.addEventListener('astro:page-load', () => {
      initThemeToggle();
      initProgressBar();
      initCodeBlocks();
      initTocScrollSpy();
    });
  </script>
</body>
</html>

