---
// [slug].astro - 动态文章编译详情页
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { formatPostDate, getRenderablePosts } from '../../lib/site';

// 1. Astro 必须的前置定义，声明所有可能生成的静态 URL 路径
export async function getStaticPaths() {
  const posts = await getRenderablePosts();
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

// 2. 从参数和 props 中获取当前页面对应的文章数据
const { post } = Astro.props;
const { title, date, description, tags = [] } = post.data;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = `${basePath}/`;
const postUrl = new URL(`${basePath}/post/${post.id}/`, Astro.site ?? Astro.url).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  author: {
    '@type': 'Person',
    name: 'Lucid',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  url: postUrl,
  keywords: tags,
};

// 3. 将 Markdown 静态渲染编译为可在 Astro 中直接嵌套使用的组件
const { Content } = await render(post);
---

<Layout title={`${title} - Lucid Hubble`} description={description} keywords={tags.length > 0 ? tags.join(', ') : undefined} canonicalUrl={postUrl} ogType="article" publishedTime={date.toISOString()} structuredData={structuredData}>
  <article class="post-detail-article">
    <!-- 文章头部 -->
    <div class="post-header">
      <!-- 返回文章列表 -->
      <a href={homeUrl} class="back-btn">
        <Icon name="arrow-left" class="back-icon" />
        文章列表
      </a>
      
      <!-- 主标题 -->
      <h1>{title}</h1>
      
      <!-- 元信息 -->
      <div class="post-meta post-detail-meta">
        <time datetime={date.toISOString()}>{formatPostDate(date)}</time>
        {tags.length > 0 && (
          <>
            <span>•</span>
            <div class="post-tags">
              {tags.map(tag => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          </>
        )}
      </div>
    </div>

    <!-- 静态编译生成的 HTML 博客正文 -->
    <div class="post-content">
      <Content />
    </div>

    <div class="post-copyright" aria-label="文章版权信息">
      <p>本文作者：Lucid</p>
      <p>原文链接：<a href={postUrl}>{postUrl}</a></p>
      <p>未经许可，禁止转载或镜像全文；引用请注明出处。</p>
    </div>
  </article>
</Layout>
