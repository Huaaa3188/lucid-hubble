---
// index.astro - 全功能交互式终端与极客主页
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import {
  calculateReadingStats,
  formatLogDate,
  getPostPath,
  getPosts,
  serializeJson,
  siteBasePath,
} from '../lib/site';

const sortedPosts = await getPosts();
const postCount = sortedPosts.length;

// 序列化文章数据给前端交互式 CLI 引擎使用（仅元信息与摘要，避免全文内联进首页）
const terminalPostsData = sortedPosts.map((post) => {
  const stats = calculateReadingStats(post.body || '');
  return {
    id: post.id,
    filename: `${post.id}.md`,
    title: post.data.title,
    date: formatLogDate(post.data.date),
    description: post.data.description,
    tags: post.data.tags || [],
    url: getPostPath(post.id),
    readingTime: stats.timeText,
    wordsText: stats.wordsText,
  };
});
---

<Layout title="Lucid Hubble">
  <!-- Zero-flash inline script before paint -->
  <script is:inline>
    (function() {
      try {
        var mode = localStorage.getItem('terminal_view_mode');
        if (mode === 'gui') {
          document.documentElement.classList.add('mode-gui');
        } else {
          document.documentElement.classList.remove('mode-gui');
        }
      } catch(e) {}
    })();
  </script>

  <!-- Mode Switcher -->
  <div class="mode-toggle-bar">
    <div class="mode-switch-group">
      <button id="btn-mode-term" type="button" class="mode-btn is-active" aria-pressed="true">
        &gt;_ TERMINAL
      </button>
      <button id="btn-mode-gui" type="button" class="mode-btn" aria-pressed="false">
        ▦ CLASSIC
      </button>
    </div>
    <div class="terminal-hint">
      Tip: Type <code>help</code> or <code>ls</code>
    </div>
  </div>

  <!-- Interactive Web Terminal Emulator -->
  <section id="terminal-wrapper" class="terminal-window">
    <div class="terminal-header-bar">
      <div class="console-dots">
        <span class="console-dot dot-red"></span>
        <span class="console-dot dot-yellow"></span>
        <span class="console-dot dot-green"></span>
      </div>
      <div class="terminal-title">lucid@hubble: ~/writings (zsh)</div>
      <div class="terminal-actions">
        <span>[TAB: AUTOCOMPLETE]</span>
      </div>
    </div>

    <div id="terminal-screen" class="terminal-screen">
      <div class="terminal-welcome">
        <div class="welcome-logo">
          &gt; LUCID_HUBBLE INTERACTIVE TERMINAL v1.0.0 (x86_64-darwin)
        </div>
        <div>Type <span class="term-cmd-inline" data-cmd="help">help</span> to view available commands, or <span class="term-cmd-inline" data-cmd="ls">ls</span> to list posts.</div>
      </div>

      <div id="terminal-history" class="terminal-history"></div>

      <div class="term-input-line">
        <span class="term-prompt">
          <span class="prompt-user">lucid</span>@<span class="prompt-host">hubble</span>:<span class="prompt-path">~/writings</span><span class="prompt-sym">$</span>
        </span>
        <input
          id="term-input"
          class="term-input-field"
          type="text"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          autofocus
        />
      </div>
    </div>
  </section>

  <!-- Classic GUI Section (Toggleable & SEO preserved) -->
  <div id="classic-gui-section">
    <!-- Console Dashboard Hero -->
    <section class="console-hero">
      <div class="console-bar">
        <div class="console-dots">
          <span class="console-dot dot-red"></span>
          <span class="console-dot dot-yellow"></span>
          <span class="console-dot dot-green"></span>
        </div>
        <div class="console-title">lucid@hubble: ~ (zsh)</div>
        <div class="console-sys">[UTF-8]</div>
      </div>
      <div class="console-body">
        <div class="console-prompt-line">
          <span class="console-user">lucid</span><span class="console-host">@hubble</span>:<span class="console-path">~</span>$ <span class="console-cmd">cat ./manifesto.txt</span>
        </div>
        <p class="hero-statement">
          服务端工程、分布式架构、自托管工具与日常碎片思考。记录一个纯静态、去中心化的个人数字花园。
        </p>
        <div class="console-metrics-grid">
          <div class="metric-box">
            <span class="metric-label">System Status</span>
            <span class="metric-value green">ONLINE / 200 OK</span>
          </div>
          <div class="metric-box">
            <span class="metric-label">Total Entries</span>
            <span class="metric-value cyan">{postCount} LOGS</span>
          </div>
          <div class="metric-box">
            <span class="metric-label">Primary Stack</span>
            <span class="metric-value amber">GO / DISTRIBUTED / ASTRO</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Writings List -->
    <section id="blog" class="blog-section">
      <div class="section-heading">
        <h2 class="section-title">ENGINEERING_LOGS</h2>
        <span class="section-count">TOTAL: {postCount}</span>
      </div>

      <div id="filter-bar" class="filter-bar hidden">
        <span>&gt; FILTER_ACTIVE: <strong id="active-tag"></strong></span>
        <button id="clear-filter" type="button" class="clear-btn">[CLEAR_FILTER]</button>
      </div>

      <div id="posts-list" class="posts-list">
        {sortedPosts.length === 0 ? (
          <p class="empty-state">&gt; NO_LOG_ENTRIES_FOUND.</p>
        ) : (
          sortedPosts.map((post) => {
            const { title, date, description, tags = [] } = post.data;
            const stats = calculateReadingStats(post.body || '');

            return (
              <article class="post-card" data-tags={tags.join(',')}>
                <div class="post-card-header">
                  <div class="post-timestamp">
                    <span aria-hidden="true">[LOG]</span>
                    <time datetime={date.toISOString()}>{formatLogDate(date)}</time>
                  </div>
                  <div class="post-reading-time">
                    <span>[{stats.timeText}]</span>
                  </div>
                </div>

                <a href={getPostPath(post.id)} class="post-card-link" data-astro-prefetch>
                  <div class="post-card-title-row">
                    <h3>{title}</h3>
                    <Icon name="arrow-up-right" class="card-arrow" />
                  </div>
                  <p class="post-card-desc">{description}</p>
                </a>

                <div class="post-card-footer">
                  <div class="tag-list">
                    {tags.map((tag) => (
                      <button
                        type="button"
                        class="tag-btn"
                        data-tag={tag}
                        aria-label={`按标签 ${tag} 筛选文章`}
                        aria-pressed="false"
                      >
                        [#{tag}]
                      </button>
                    ))}
                  </div>
                  <a href={getPostPath(post.id)} class="read-cta" tabindex="-1" aria-hidden="true">
                    <span>READ_LOG</span>
                    <span>-&gt;</span>
                  </a>
                </div>
              </article>
            );
          })
        )}
      </div>
    </section>
  </div>
</Layout>

<!-- Client-side Interactive CLI Engine Data -->
<script id="terminal-data" type="application/json" set:html={serializeJson({ posts: terminalPostsData, basePath: siteBasePath })}></script>
<script src="../scripts/home.ts"></script>
