---
// about.astro - 极客工程系统档案 / manual page
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getSitePath } from '../lib/site';

const writingUrl = getSitePath('#blog');

const principles = [
  {
    icon: 'book-open' as const,
    title: '01. 文字优先 (TEXT_FIRST)',
    body: '关注工程实践、工具探索与日常思考的长期沉淀。不追逐算法热点，保持文字与技术记录的扎实与真实。',
  },
  {
    icon: 'layers' as const,
    title: '02. 纯粹静态 (PURE_STATIC)',
    body: 'Markdown 编写，Astro 编译，全静态托管。去中心化、零后台、零数据库，轻量且具备极长的生命力。',
  },
  {
    icon: 'feather' as const,
    title: '03. 零多余运行时 (ZERO_RUNTIME)',
    body: '零外部第三方跟踪与重量框架注入，图标与样式纯本地原生化。拒绝无谓的依赖入侵，保持毫秒级加载。',
  },
  {
    icon: 'shield-check' as const,
    title: '04. 长效发现 (LONG_TERM_DISCOVERY)',
    body: '标准 RSS 自动发现、完整 Sitemap 与语义化结构数据，确保每篇文章在时间沉淀中都能被正常检索。',
  },
];
---

<Layout
  title="About - Lucid Hubble"
  description="关于 Lucid：服务端工程、开发工具、读书与日常随笔。记录一个静态数字花园的构建与思考。"
>
  <div class="about-shell">
    <div class="about-header-bar">
      <span>MANPAGES(1) // SYSTEM_SPEC</span>
      <span>LUCID_HUBBLE (v1.0.0)</span>
      <span>[ONLINE]</span>
    </div>

    <div class="about-body">
      <section class="man-section">
        <h2 class="man-title">:: NAME</h2>
        <div class="man-text">
          <p>
            <strong>Lucid</strong> — 服务端工程师 / 基础设施折腾者 / 静态数字花园 Gardener。
          </p>
        </div>
      </section>

      <section class="man-section">
        <h2 class="man-title">:: SYNOPSIS</h2>
        <div class="man-text">
          <p>
            日常主要与后端架构、分布式系统、网络协议与基础设施打交道。热衷于自托管开源工具、构建确定性的开发环境与极客小工具。
          </p>
        </div>
      </section>

      <section class="man-section">
        <h2 class="man-title">:: DESCRIPTION</h2>
        <div class="man-text">
          <p>
            这里是我在喧嚣的社交信息流之外的<strong>静态技术沉淀点</strong>。
          </p>
          <p>
            那些线上排障的深度复盘、工具链的配置心得，以及深夜思考的碎片感悟，都在这里静静留存。
            站点的核心价值在于内容的持久与真实，保持纯净与极速访问就是最高优先级。
          </p>
          <p>
            如需阅读所有沉淀文章，请访问命令行入口：<a href={writingUrl}>~/writings</a>。
          </p>
        </div>
      </section>

      <section class="man-section">
        <h2 class="man-title">:: ENGINEERING_PRINCIPLES</h2>
        <div class="man-grid">
          {principles.map((item) => (
            <div class="man-card">
              <h4>{item.title}</h4>
              <p>{item.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="man-section man-section-last">
        <h2 class="man-title">:: SYSTEM_ENVIRONMENT</h2>
        <div class="man-card system-environment-card">
          <p>&gt; ENGINE: Astro 7.x (Content Layer + Speculation Rules)</p>
          <p>&gt; RUNTIME: Zero Client JS (Vanilla DOM Enhancements)</p>
          <p>&gt; HOSTING: GitHub Pages Static Deployment</p>
          <p>&gt; STACK: TypeScript / CSS Custom Properties / Shiki</p>
        </div>
      </section>
    </div>
  </div>
</Layout>
