---
/**
 * Site icons: Lucide via @lucide/astro (build-time static SVG).
 * `github` is a brand mark — Lucide no longer ships brand icons, so it is
 * a local path drawn with the same stroke conventions as Lucide.
 */
import {
  ArrowLeft,
  ArrowUpRight,
  BookOpen,
  Feather,
  Layers,
  Moon,
  ShieldCheck,
  Sun,
} from '@lucide/astro';

const lucideIcons = {
  'arrow-left': ArrowLeft,
  'arrow-up-right': ArrowUpRight,
  'book-open': BookOpen,
  feather: Feather,
  layers: Layers,
  moon: Moon,
  'shield-check': ShieldCheck,
  sun: Sun,
} as const;

type LucideName = keyof typeof lucideIcons;
type IconName = LucideName | 'github';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  'aria-hidden'?: boolean | 'true' | 'false';
}

const {
  name,
  size = 18,
  strokeWidth = 2,
  class: className,
  'aria-hidden': ariaHidden = true,
} = Astro.props;

const isGithub = name === 'github';
const LucideIcon = isGithub ? null : lucideIcons[name];
---

{isGithub ? (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden={ariaHidden}
  >
    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
    <path d="M9 18c-4.51 2-5-2-7-2"></path>
  </svg>
) : (
  <LucideIcon
    size={size}
    stroke-width={strokeWidth}
    class={className}
    aria-hidden={ariaHidden}
  />
)}
