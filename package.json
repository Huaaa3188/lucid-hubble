{
  "name": "lucid-hubble-astro",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --port 8000",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev --port 8000",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "astro preview --port 8000",
    "check:dist": "node scripts/check-dist.mjs",
    "new:post": "node scripts/new-post.mjs",
    "verify": "npm run build && npm run check:dist"
  },
  "dependencies": {
    "@lucide/astro": "^1.26.0",
    "astro": "^7.1.3"
  }
}
